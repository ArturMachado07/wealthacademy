# Password temporária para a direcção validar o site na Vercel antes de
# publicar num domínio público. Definir em Vercel > Project Settings > Environment Variables.
STAGING_PASSWORD=defina-uma-password-forte
NEXT_PUBLIC_SITE_URL=https://wealthacademy.ao

# Supabase — Área do Aluno / Admin (auth + base de dados).
# Criar um projecto gratuito em supabase.com, depois correr supabase/schema.sql
# no SQL Editor do projecto. As chaves estão em Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secreta — nunca expor no browser. Usada só em rotas de servidor (API/webhooks).
SUPABASE_SECRET_KEY=

# Pagamentos — Multicaixa Express via EMIS GPO / ProxyPay.
# Requer adesão ao GPO através do banco da Wealth Academy para obter o
# POS_ID e o token da API (começar pelo ambiente sandbox).
# Docs: https://developer.proxypay.co.ao/opg/v1/
PROXYPAY_API_TOKEN=
PROXYPAY_POS_ID=
# Opcional — por defeito usa sandbox fora de produção, produção em produção.
PROXYPAY_BASE_URL=

# Emails transaccionais (confirmação de inscrição, certificado emitido).
# Criar conta grátis em resend.com, verificar um domínio próprio (ex. waca.ao)
# e gerar uma API key. Sem isto, os emails são apenas ignorados (o site
# continua a funcionar, só não envia notificações).
RESEND_API_KEY=
# Tem de ser um endereço do domínio verificado no Resend.
RESEND_FROM_EMAIL=Wealth Academy <notificacoes@waca.ao>
